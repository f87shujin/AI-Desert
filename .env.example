# DeepSeek API Configuration
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# MongoDB Configuration
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/DatabaseName

# Google Custom Search API for Image Fetching
GOOGLE_API_KEY_1=your_google_api_key_1
GOOGLE_API_KEY_2=your_google_api_key_2
GOOGLE_SEARCH_ENGINE_ID=your_search_engine_id

# Flask Secret Key (generate a new one for production using: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=your_secret_key_here
